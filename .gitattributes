# Auto detect text files and perform LF normalization
* text=auto

# Keep the Composer dist archive to what an app needs at runtime:
# src/, resources/, dist/, stubs/, composer.json, LICENSE, README.md.
/.claude                export-ignore
/.github                export-ignore
/.zcode                 export-ignore
/playground             export-ignore
/scripts                export-ignore
/tests                  export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/CONVENTIONS.md         export-ignore
/PLAN.md                export-ignore
/SECTION-CONVENTIONS.md export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/phpunit.xml            export-ignore
/resources/fonts/.gitkeep export-ignore
