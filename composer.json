{
    "name": "sigta/ui",
    "description": "Sigta UI — Livewire/Blade component library carrying the Sigta brand. Paper, ink, and hand-drawn accents as a foundation for landing pages and SaaS platforms.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "blade",
        "components",
        "ui",
        "tailwindcss",
        "alpinejs",
        "design-system"
    ],
    "homepage": "https://github.com/sigta-hq/ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Søren Risbøll Frisk",
            "email": "sf@sigta.dk"
        }
    ],
    "support": {
        "issues": "https://github.com/sigta-hq/ui/issues",
        "source": "https://github.com/sigta-hq/ui",
        "docs": "https://github.com/sigta-hq/ui#readme",
        "security": "https://github.com/sigta-hq/ui/security/policy"
    },
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "mallardduck/blade-lucide-icons": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sigta\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sigta\\Ui\\SigtaServiceProvider"
            ],
            "aliases": {
                "Sigta": "Sigta\\Ui\\Facades\\Sigta"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
