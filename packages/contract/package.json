{
    "name": "@sigta-hq/contract",
    "version": "0.1.0",
    "description": "Sigta UI contract — component manifests, the shared component stylesheet, tokens, fonts and icons every runtime renders against.",
    "license": "UNLICENSED",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sigta-hq/ui.git",
        "directory": "packages/contract"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist",
        "manifest.json",
        "css",
        "fonts",
        "icons/lucide.json",
        "src"
    ],
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./manifest.json": "./manifest.json",
        "./icons": {
            "types": "./dist/icons.d.ts",
            "default": "./dist/icons.js"
        },
        "./sections": {
            "types": "./dist/sections.d.ts",
            "default": "./dist/sections.js"
        },
        "./sigta.css": "./dist/css/sigta.css",
        "./core.css": "./dist/css/core.css",
        "./theme.css": "./dist/css/theme.css",
        "./theme.example.css": "./dist/css/theme.example.css",
        "./fonts.css": "./dist/css/fonts.css",
        "./components.css": "./dist/css/components.css",
        "./tailwind.css": "./dist/css/tailwind.css",
        "./fonts/*": "./fonts/*",
        "./preflight.css": "./dist/css/preflight.css"
    },
    "scripts": {
        "build": "node scripts/build.ts",
        "test": "vitest run"
    }
}
