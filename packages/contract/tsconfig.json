{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "erasableSyntaxOnly": true
    },
    "include": ["src/index.ts", "src/schema.ts", "src/examples.ts", "src/icons.ts", "src/sections.ts", "src/manifests/**/*.ts"]
}
